{
  "name": "dsh-plugin-herdr",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "presets"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/client.d.cts",
      "default": "./lib/client.cjs"
    },
    "./client-entry": {
      "types": "./lib/client-entry.d.mts",
      "default": "./lib/client-entry.mjs"
    },
    "./session-mode": {
      "types": "./lib/session-mode.d.mts",
      "default": "./lib/session-mode.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.web.config.ts",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:types:check": "node scripts/gen-types.mjs --check",
    "test": "pnpm build && node --experimental-transform-types --test \"test/unit/*.test.ts\"",
    "test:integration": "pnpm build && node test/integration/run.mjs && node test/integration/extended.mjs && node test/integration/events.mjs && node test/integration/close-rename.mjs && node test/integration/terminal-session.mjs",
    "typecheck": "tsc --noEmit",
    "quality": "pnpm build && pnpm typecheck && pnpm gen:types:check && node --experimental-transform-types --test \"test/unit/*.test.ts\"",
    "prepare": "pnpm build",
    "dsh:blank": "node scripts/blank-dsh.mjs",
    "dsh:blank:reset": "node scripts/blank-dsh.mjs --reset"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-util-values": {
      "optional": true
    }
  }
}
